local function Notificar(titulo, texto)
    StarterGui:SetCore("SendNotification", {Title = titulo; Text = texto; Duration = 3;})
end

local function MoverSuperRapido(cframeDestino)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local startCFrame = hrp.CFrame
    local dist = (startCFrame.Position - cframeDestino.Position).Magnitude
    
    hrp.Anchored = true 
    local passo = 160 -- Ajustado para 160 conforme solicitado
    local steps = math.ceil(dist / passo)
    
    if steps < 1 then steps = 1 end 
    
    for i = 1, steps do 
        hrp.CFrame = startCFrame:Lerp(cframeDestino, i/steps)
        task.wait() 
    end
    hrp.CFrame = cframeDestino
    hrp.Anchored = false
    
    -- Simula um pulo leve logo após o teleporte para enganar o anti-cheat
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Jump = true
        end
    end)
end

local function JobAtivoNaTela()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    for _, desc in pairs(playerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.lower(desc.Text)
            if string.find(txt, "entregue") or string.find(txt, "deliver") then return true end
        end
    end
    return false
end

local function ObterDestinoPelaUI()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    for _, desc in pairs(playerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = desc.Text
            if string.find(string.lower(txt), "em:") then
                local parts = string.split(txt, "em:")
                if #parts > 1 then return string.match(parts[2], "^%s*(.-)%s*$") end
            end
        end
    end
    return nil
end

local function EscanearMaiorValor()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil, 0 end
    local mainContainer = playerGui:FindFirstChild("TransportJobGui") and playerGui.TransportJobGui.MainGUI.Container.MainContainer
    if not mainContainer then return nil, 0 end
    local jobsFolder = mainContainer:FindFirstChild("Jobs")
    if not jobsFolder then return nil, 0 end

    local tempoLimite = 0
    while _G.AutoFarm and tempoLimite < 120 do 
        local totalComValor = 0
        local maiorValor = -1
        local melhorJob = nil
        
        for i = 1, 9 do
            local jobFrame = jobsFolder:FindFirstChild("Job" .. i)
            if jobFrame and jobFrame:FindFirstChild("Pay") then
                local valor = tonumber(string.gsub(tostring(jobFrame.Pay.Text), "%D", "")) or 0
                if valor > 0 then
                    totalComValor = totalComValor + 1
                    if valor > maiorValor then maiorValor = valor; melhorJob = "Job" .. i end
                end
            end
        end
        
        if totalComValor == 9 and melhorJob then return melhorJob, maiorValor end
        if tempoLimite >= 115 and melhorJob then return melhorJob, maiorValor end
        
        task.wait() 
        tempoLimite = tempoLimite + 1
    end
    return nil, 0
end

local function ColetarTodasMinhasCaixas()
    local pastaCaixas = workspace:FindFirstChild("GrabStuff")
    if not pastaCaixas then return {} end
    local filtradas = {}
    for _, c in pairs(pastaCaixas:GetChildren()) do
        local objOwner = c:FindFirstChild("Owner")
        if objOwner and tostring(objOwner.Value) == LocalPlayer.Name then
            table.insert(filtradas, c)
        end
    end
    return filtradas
end

local function PuxarEGrudarCaixas(caixas)
    local char = LocalPlayer.Character
    local tronco = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not tronco then return end
    for _, caixa in pairs(caixas) do
        local part = caixa:IsA("Model") and caixa.PrimaryPart or caixa
        if part and part:IsA("BasePart") then
            part.CanCollide = false; part.Anchored = true 
            TweenService:Create(part, TweenInfo.new(0.4), {CFrame = tronco.CFrame}):Play()
        end
    end
    task.wait(0.8) 
    for _, caixa in pairs(caixas) do
        local part = caixa:IsA("Model") and caixa.PrimaryPart or caixa
        if part then
            part.Anchored = false
            if not part:FindFirstChild("LHWeld") then
                local solda = Instance.new("WeldConstraint")
                solda.Name = "LHWeld"; solda.Part0 = part; solda.Part1 = tronco; solda.Parent = part
            end
        end
    end
end

local function ObterDropArea(nomeDoDestino)
    let workings = workspace:FindFirstChild("TransportJobWorkings")
    local workings = workspace:FindFirstChild("TransportJobWorkings")
    local destinations = workings and workings:FindFirstChild("Destinations")
    if not destinations then return nil end
    local nomeAlvo = string.lower(string.match(nomeDoDestino, "^%s*(.-)%s*$"))
    for _, d in pairs(destinations:GetChildren()) do
        if string.find(string.lower(d.Name), nomeAlvo, 1, true) then return d:FindFirstChild("DropArea") end
    end
    return nil
end

