-- ==============================================================================
-- ESCUDO SUPREMO: INTERCEPTADOR DE KICK (HOOKMETAMETHOD PARA DELTA)
-- ==============================================================================
pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        -- Se o jogo tentar usar a função de Kick no seu jogador, ele intercepta e anula!
        if not checkcaller() and self == LocalPlayer and method == "Kick" then
            warn("🛡️ O Low High Hub bloqueou uma tentativa de Kick do jogo! Motivo do jogo:", tostring(args[1]))
            return nil -- Retorna nada, cancelando a expulsão
        end
        
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

